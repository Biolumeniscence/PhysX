<Window x:Class="PhysX.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображения"
        Width="1160"
        Height="760"
        MinWidth="720"
        MinHeight="460"
        Background="#111820"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        KeyDown="CloseOnEscape">
    <Window.Resources>
        <Style x:Key="PreviewButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderBrush" Value="#D7DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonShell"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#F3F7FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource PreviewButtonStyle}"
                    Content="Закрыть"
                    Click="ClosePreview" />
            <TextBlock x:Name="PreviewTitle"
                       VerticalAlignment="Center"
                       Foreground="#F8FAFC"
                       FontSize="22"
                       FontWeight="Black"
                       TextWrapping="Wrap" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="12"
                CornerRadius="22"
                Background="#F8FAFC"
                BorderBrush="#D7DEE6"
                BorderThickness="1"
                ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <Image x:Name="PreviewImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
