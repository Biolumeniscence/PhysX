<Window x:Class="PhysX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PhysX.Models"
        Title="PhysX"
        Width="1320"
        Height="840"
        MinWidth="980"
        MinHeight="680"
        Background="#EEF2F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ImageBrush x:Key="SelectedTopicBrush"
                    ImageSource="pack://application:,,,/assets/topic-atlas.png"
                    Viewbox="{Binding SelectedTopic.TileViewbox}"
                    ViewboxUnits="RelativeToBoundingBox"
                    Stretch="UniformToFill" />

        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#20252B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonShell"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#F7F9FB" />
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="#AEB8C2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#E8EDF2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShell" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Height" Value="50" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>

        <Style x:Key="TopicItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemRoot"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#EEF2F6" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#CBD3DC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#D9DEE5" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#8E98A3" />
                                <Setter TargetName="ItemRoot" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="BorderBrush" Value="#D7DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardShell"
                                MinHeight="252"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardShell" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CardShell" Property="BorderBrush" Value="#AEB8C2" />
                                <Setter TargetName="CardShell" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardShell" Property="Background" Value="#EEF2F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardShell" Property="Opacity" Value="0.58" />
                                <Setter TargetName="CardShell" Property="Background" Value="#F1F3F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChargeKindsVisual">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="8" CornerRadius="24" Background="#FFF4F4">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="190" Height="220">
                            <TextBlock Canvas.Left="18" Canvas.Top="14" Text="поле от + наружу" FontWeight="Black" Foreground="#7A2630" />
                            <Line X1="95" Y1="110" X2="95" Y2="28" Stroke="#E64646" StrokeThickness="3" />
                            <Line X1="95" Y1="110" X2="166" Y2="68" Stroke="#E64646" StrokeThickness="3" />
                            <Line X1="95" Y1="110" X2="166" Y2="152" Stroke="#E64646" StrokeThickness="3" />
                            <Line X1="95" Y1="110" X2="95" Y2="192" Stroke="#E64646" StrokeThickness="3" />
                            <Line X1="95" Y1="110" X2="24" Y2="152" Stroke="#E64646" StrokeThickness="3" />
                            <Line X1="95" Y1="110" X2="24" Y2="68" Stroke="#E64646" StrokeThickness="3" />
                            <TextBlock Canvas.Left="88" Canvas.Top="14" Text="↑" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <TextBlock Canvas.Left="160" Canvas.Top="58" Text="↗" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <TextBlock Canvas.Left="160" Canvas.Top="144" Text="↘" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <TextBlock Canvas.Left="88" Canvas.Top="180" Text="↓" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <TextBlock Canvas.Left="12" Canvas.Top="144" Text="↙" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <TextBlock Canvas.Left="12" Canvas.Top="58" Text="↖" FontSize="22" FontWeight="Black" Foreground="#E64646" />
                            <Grid Canvas.Left="60" Canvas.Top="75" Width="70" Height="70">
                                <Ellipse Fill="#E64646" Stroke="#9E1F1F" StrokeThickness="4" />
                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" FontWeight="Black" Foreground="White" />
                            </Grid>
                        </Canvas>
                    </Viewbox>
                </Border>

                <Border Grid.Column="1" Margin="8" CornerRadius="24" Background="#EDF2F7">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="100" Height="100">
                            <Ellipse Fill="#F7FAFC" Stroke="#7B8794" StrokeThickness="4" />
                            <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" FontWeight="Black" Foreground="#4B5563" />
                        </Grid>
                        <TextBlock Text="нейтральный" Margin="0,14,0,0" FontWeight="Black" Foreground="#20252B" />
                        <TextBlock Text="плюсы и минусы уравновешены" Margin="0,6,0,0" Foreground="#66717D" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="8" CornerRadius="24" Background="#EAF1FF">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="190" Height="220">
                            <TextBlock Canvas.Left="18" Canvas.Top="14" Text="поле к - внутрь" FontWeight="Black" Foreground="#164B8F" />
                            <Line X1="95" Y1="28" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <Line X1="166" Y1="68" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <Line X1="166" Y1="152" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <Line X1="95" Y1="192" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <Line X1="24" Y1="152" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <Line X1="24" Y1="68" X2="95" Y2="110" Stroke="#2F6FE4" StrokeThickness="3" />
                            <TextBlock Canvas.Left="88" Canvas.Top="52" Text="↓" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <TextBlock Canvas.Left="134" Canvas.Top="78" Text="↙" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <TextBlock Canvas.Left="134" Canvas.Top="124" Text="↖" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <TextBlock Canvas.Left="88" Canvas.Top="144" Text="↑" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <TextBlock Canvas.Left="38" Canvas.Top="124" Text="↗" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <TextBlock Canvas.Left="38" Canvas.Top="78" Text="↘" FontSize="22" FontWeight="Black" Foreground="#2F6FE4" />
                            <Grid Canvas.Left="60" Canvas.Top="75" Width="70" Height="70">
                                <Ellipse Fill="#2F6FE4" Stroke="#174AA5" StrokeThickness="4" />
                                <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="44" FontWeight="Black" Foreground="White" />
                            </Grid>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChargeInteractionVisual">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.08*" />
                    <RowDefinition Height="0.92*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" CornerRadius="22" Background="#FFF4F4" ClipToBounds="True">
                        <Image Source="pack://application:,,,/assets/two-positive-particles.png"
                               Stretch="UniformToFill"
                               Cursor="Hand"
                               ToolTip="Открыть крупно"
                               Tag="pack://application:,,,/assets/two-positive-particles.png"
                               MouseLeftButtonUp="OpenImagePreview" />
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,0,0" CornerRadius="22" Background="#EEF6FF" ClipToBounds="True">
                        <Image Source="pack://application:,,,/assets/two-negative-particles.png"
                               Stretch="UniformToFill"
                               Cursor="Hand"
                               ToolTip="Открыть крупно"
                               Tag="pack://application:,,,/assets/two-negative-particles.png"
                               MouseLeftButtonUp="OpenImagePreview" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" CornerRadius="24" Background="#F7FBFF" ClipToBounds="True">
                    <Image Source="pack://application:,,,/assets/positive-negative-attraction.png"
                           Stretch="UniformToFill"
                           Cursor="Hand"
                           ToolTip="Открыть крупно"
                           Tag="pack://application:,,,/assets/positive-negative-attraction.png"
                           MouseLeftButtonUp="OpenImagePreview" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PolarizationVisual">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="24" Background="#FFF7ED" ClipToBounds="True">
                    <Image Source="pack://application:,,,/assets/polarization-positive-external.png"
                           Stretch="Uniform"
                           Cursor="Hand"
                           ToolTip="Открыть крупно"
                           Tag="pack://application:,,,/assets/polarization-positive-external.png"
                           MouseLeftButtonUp="OpenImagePreview" />
                </Border>

                <Border Grid.Row="1" CornerRadius="24" Background="#EEF6FF" ClipToBounds="True">
                    <Image Source="pack://application:,,,/assets/polarization-negative-external.png"
                           Stretch="Uniform"
                           Cursor="Hand"
                           ToolTip="Открыть крупно"
                           Tag="pack://application:,,,/assets/polarization-negative-external.png"
                           MouseLeftButtonUp="OpenImagePreview" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CurrentFlowVisual">
            <Grid Margin="10">
                <Border CornerRadius="24" Background="#EEF6FF">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="430" Height="250">
                            <TextBlock Canvas.Left="24" Canvas.Top="18" Text="направленное движение зарядов" FontWeight="Black" Foreground="#164B8F" />
                            <Rectangle Canvas.Left="54" Canvas.Top="106" Width="322" Height="44" RadiusX="22" RadiusY="22" Fill="#DBEAFE" Stroke="#1D63C9" StrokeThickness="4" />
                            <TextBlock Canvas.Left="88" Canvas.Top="83" Text="e-" FontSize="22" FontWeight="Black" Foreground="#1D63C9" />
                            <TextBlock Canvas.Left="152" Canvas.Top="154" Text="e-" FontSize="22" FontWeight="Black" Foreground="#1D63C9" />
                            <TextBlock Canvas.Left="220" Canvas.Top="83" Text="e-" FontSize="22" FontWeight="Black" Foreground="#1D63C9" />
                            <TextBlock Canvas.Left="290" Canvas.Top="154" Text="e-" FontSize="22" FontWeight="Black" Foreground="#1D63C9" />
                            <Line X1="94" Y1="128" X2="336" Y2="128" Stroke="#116D87" StrokeThickness="5" />
                            <TextBlock Canvas.Left="326" Canvas.Top="103" Text="→" FontSize="38" FontWeight="Black" Foreground="#116D87" />
                            <TextBlock Canvas.Left="118" Canvas.Top="184" Text="I - сила тока" FontSize="24" FontWeight="Black" Foreground="#111820" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ClosedCircuitVisual">
            <Grid Margin="10">
                <Border CornerRadius="24" Background="#F0FDF4">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="430" Height="250">
                            <TextBlock Canvas.Left="24" Canvas.Top="18" Text="ток идет только по замкнутой цепи" FontWeight="Black" Foreground="#245B3C" />
                            <Path Data="M 100 125 L 170 125 M 260 125 L 330 125 M 330 125 L 330 190 L 100 190 L 100 125"
                                  Stroke="#2F8F5B" StrokeThickness="8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="170" Y1="125" X2="260" Y2="125" Stroke="#2F8F5B" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Rectangle Canvas.Left="86" Canvas.Top="94" Width="28" Height="62" RadiusX="6" RadiusY="6" Fill="#FFFFFF" Stroke="#245B3C" StrokeThickness="4" />
                            <TextBlock Canvas.Left="79" Canvas.Top="72" Text="источник" FontSize="15" FontWeight="Bold" Foreground="#245B3C" />
                            <Ellipse Canvas.Left="193" Canvas.Top="94" Width="44" Height="44" Fill="#FDE68A" Stroke="#D8A313" StrokeThickness="4" />
                            <TextBlock Canvas.Left="184" Canvas.Top="72" Text="лампа" FontSize="15" FontWeight="Bold" Foreground="#7A4B00" />
                            <TextBlock Canvas.Left="282" Canvas.Top="148" Text="ключ" FontSize="15" FontWeight="Bold" Foreground="#245B3C" />
                            <TextBlock Canvas.Left="252" Canvas.Top="86" Text="→" FontSize="34" FontWeight="Black" Foreground="#116D87" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OhmLawVisual">
            <Grid Margin="10">
                <Border CornerRadius="24" Background="#F8F4FF">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="430" Height="250">
                            <TextBlock Canvas.Left="26" Canvas.Top="18" Text="напряжение толкает, сопротивление мешает" FontWeight="Black" Foreground="#4C1D95" />
                            <Line X1="56" Y1="132" X2="372" Y2="132" Stroke="#7A3FD1" StrokeThickness="6" />
                            <TextBlock Canvas.Left="56" Canvas.Top="96" Text="U" FontSize="34" FontWeight="Black" Foreground="#7A3FD1" />
                            <TextBlock Canvas.Left="96" Canvas.Top="104" Text="→" FontSize="34" FontWeight="Black" Foreground="#7A3FD1" />
                            <Rectangle Canvas.Left="178" Canvas.Top="106" Width="84" Height="52" RadiusX="10" RadiusY="10" Fill="#FFFFFF" Stroke="#C64D72" StrokeThickness="4" />
                            <TextBlock Canvas.Left="206" Canvas.Top="116" Text="R" FontSize="30" FontWeight="Black" Foreground="#C64D72" />
                            <TextBlock Canvas.Left="296" Canvas.Top="98" Text="I" FontSize="34" FontWeight="Black" Foreground="#116D87" />
                            <TextBlock Canvas.Left="324" Canvas.Top="104" Text="→" FontSize="34" FontWeight="Black" Foreground="#116D87" />
                            <TextBlock Canvas.Left="140" Canvas.Top="180" Text="I = U / R" FontSize="30" FontFamily="Cambria Math" FontWeight="Black" Foreground="#111820" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CircuitTypesVisual">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="24" Background="#EEF6FF">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="210" Height="230">
                            <TextBlock Canvas.Left="22" Canvas.Top="18" Text="последовательно" FontWeight="Black" Foreground="#164B8F" />
                            <Line X1="38" Y1="116" X2="172" Y2="116" Stroke="#1D63C9" StrokeThickness="6" />
                            <Rectangle Canvas.Left="68" Canvas.Top="94" Width="34" Height="44" RadiusX="8" RadiusY="8" Fill="White" Stroke="#1D63C9" StrokeThickness="4" />
