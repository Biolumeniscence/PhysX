                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="24" Background="#ECFDF3">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="210" Height="230">
                            <TextBlock Canvas.Left="24" Canvas.Top="18" Text="параллельно" FontWeight="Black" Foreground="#245B3C" />
                            <Line X1="44" Y1="82" X2="44" Y2="154" Stroke="#2F8F5B" StrokeThickness="6" />
                            <Line X1="166" Y1="82" X2="166" Y2="154" Stroke="#2F8F5B" StrokeThickness="6" />
                            <Line X1="44" Y1="92" X2="166" Y2="92" Stroke="#2F8F5B" StrokeThickness="6" />
                            <Line X1="44" Y1="144" X2="166" Y2="144" Stroke="#2F8F5B" StrokeThickness="6" />
                            <Rectangle Canvas.Left="88" Canvas.Top="72" Width="34" Height="40" RadiusX="8" RadiusY="8" Fill="White" Stroke="#2F8F5B" StrokeThickness="4" />
                            <Rectangle Canvas.Left="88" Canvas.Top="124" Width="34" Height="40" RadiusX="8" RadiusY="8" Fill="White" Stroke="#2F8F5B" StrokeThickness="4" />
                            <TextBlock Canvas.Left="38" Canvas.Top="178" Text="несколько ветвей" FontWeight="Bold" Foreground="#245B3C" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConductorVisual">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="24" Background="#ECFDF3">
                    <Grid>
                        <TextBlock Text="проводник" Margin="22,18,0,0" FontWeight="Black" Foreground="#245B3C" />
                        <Rectangle Height="62" RadiusX="22" RadiusY="22" Fill="#A7F3D0" Stroke="#2F8F5B" StrokeThickness="3" Margin="42,90" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#0F766E" HorizontalAlignment="Left" Margin="86,108,0,0" VerticalAlignment="Top" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#0F766E" HorizontalAlignment="Center" Margin="0,108,0,0" VerticalAlignment="Top" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#0F766E" HorizontalAlignment="Right" Margin="0,108,86,0" VerticalAlignment="Top" />
                        <TextBlock Text="электроны могут смещаться" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Foreground="#245B3C" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="24" Background="#FFF7ED">
                    <Grid>
                        <TextBlock Text="изолятор" Margin="22,18,0,0" FontWeight="Black" Foreground="#92400E" />
                        <Rectangle Height="62" RadiusX="22" RadiusY="22" Fill="#FED7AA" Stroke="#EF8B21" StrokeThickness="3" Margin="42,90" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#9A3412" HorizontalAlignment="Left" Margin="94,108,0,0" VerticalAlignment="Top" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#9A3412" HorizontalAlignment="Center" Margin="0,108,0,0" VerticalAlignment="Top" />
                        <TextBlock Text="e-" FontSize="24" FontWeight="Black" Foreground="#9A3412" HorizontalAlignment="Right" Margin="0,108,94,0" VerticalAlignment="Top" />
                        <TextBlock Text="заряды почти закреплены" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Foreground="#92400E" FontWeight="SemiBold" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChargeConservationVisual">
            <Grid Margin="10">
                <Border CornerRadius="24" Background="#F4F0FF">
                    <Grid>
                        <TextBlock Text="заряд не исчезает, а перераспределяется" Margin="22,18,0,0" FontWeight="Black" Foreground="#4C1D95" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Margin="18">
                                <Ellipse Width="86" Height="86" Fill="#E64646" />
                                <TextBlock Text="+4q" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="24" FontWeight="Black" Foreground="#7A2630" />
                            </StackPanel>
                            <TextBlock Text="+" VerticalAlignment="Center" FontSize="34" FontWeight="Black" Foreground="#4C1D95" />
                            <StackPanel Margin="18">
                                <Ellipse Width="86" Height="86" Fill="#2F6FE4" />
                                <TextBlock Text="-2q" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="24" FontWeight="Black" Foreground="#164B8F" />
