                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Margin="10,10,10,0" CornerRadius="16" ClipToBounds="True">
                                            <Border.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/assets/topic-atlas.png"
                                                            Viewbox="{Binding TileViewbox}"
                                                            ViewboxUnits="RelativeToBoundingBox"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="18,15,18,18">
                                            <Border Width="44"
                                                    Height="6"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="4"
                                                    Background="{Binding AccentBrush}" />
                                            <TextBlock Text="{Binding Title}"
                                                       Margin="0,14,0,8"
                                                       Foreground="#121820"
                                                       FontWeight="Black"
                                                       FontSize="20"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#66717D"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       TextWrapping="Wrap" />
                                            <Border HorizontalAlignment="Left"
                                                    Margin="0,14,0,0"
                                                    Padding="9,6"
                                                    CornerRadius="12"
                                                    Background="{Binding ChipBrush}">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding ChipTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="Black" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1"
                          Visibility="{Binding LessonPageVisibility}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="24"
                            Margin="0,0,0,18"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1"
                            CornerRadius="24"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Text="{Binding LessonProgressText}"
                                           Foreground="#66717D"
                                           FontWeight="Black"
                                           FontSize="12" />
                                <TextBlock Text="{Binding CurrentLessonPage.Title}"
                                           Margin="0,8,0,0"
                                           Foreground="#111820"
                                           FontWeight="Black"
                                           FontSize="34"
                                           LineHeight="38"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CurrentLessonPage.Subtitle}"
                                           Margin="0,8,0,0"
                                           Foreground="#116D87"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CurrentLessonPage.Body}"
                                           Margin="0,18,0,0"
                                           Foreground="#374151"
                                           FontSize="17"
                                           LineHeight="28"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    MinHeight="330"
                                    CornerRadius="22"
                                    Background="#F8FAFC"
                                    BorderBrush="#E1E7EE"
                                    BorderThickness="1">
                                <ContentControl Content="{Binding CurrentLessonPage}">
                                    <ContentControl.Style>
                                        <Style TargetType="{x:Type ContentControl}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ChargeKindsVisual}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="interaction">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ChargeInteractionVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="conductor">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ConductorVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="conservation">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ChargeConservationVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="polarization">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource PolarizationVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="current-flow">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CurrentFlowVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="closed-circuit">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ClosedCircuitVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="ohm-law">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OhmLawVisual}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentLessonPage.VisualKind}" Value="circuit-types">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CircuitTypesVisual}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,18,0"
                                Padding="22"
                                CornerRadius="22"
                                BorderBrush="#D7DEE6"
                                BorderThickness="1"
                                Background="#F9FAFB">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentLessonPage.KeyPoint}"
                                           Foreground="#20252B"
                                           FontWeight="Black"
                                           FontSize="21"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        CornerRadius="18"
                                        BorderBrush="#D7DEE6"
                                        BorderThickness="1"
                                        Background="White">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentLessonPage.FormulaTitle}"
                                                   Foreground="#116D87"
                                                   FontWeight="Black"
                                                   FontSize="15" />
                                        <ItemsControl ItemsSource="{Binding CurrentLessonPage.Formulas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="{x:Type ContentControl}">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource TextFormulaTemplate}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="fraction">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource FractionFormulaTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="parts">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource PartsFormulaTemplate}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="fractionParts">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource FractionPartsFormulaTemplate}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CurrentLessonPage.ExampleTitle}"
                                           Margin="0,18,0,6"
                                           Foreground="#116D87"
                                           FontWeight="Black"
                                           FontSize="16" />
                                <TextBlock Text="{Binding CurrentLessonPage.Example}"
                                           Foreground="#4B5563"
                                           FontSize="16"
                                           LineHeight="25"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="18"
                                CornerRadius="22"
                                BorderBrush="#D7DEE6"
                                BorderThickness="1"
                                Background="White">
                            <StackPanel>
                                <TextBlock Text="Навигация по уроку"
                                           Foreground="#20252B"
                                           FontWeight="Black"
                                           FontSize="20" />
                                <TextBlock Text="Это страницы материала, а не карточки. Здесь можно спокойно читать теорию по шагам."
                                           Margin="0,8,0,16"
                                           Foreground="#66717D"
                                           TextWrapping="Wrap"
                                           LineHeight="22" />
                                <Button Style="{StaticResource RoundedButtonStyle}"
                                        Margin="0,0,0,10"
                                        Content="Предыдущая страница"
                                        IsEnabled="{Binding CanGoPreviousLessonPage}"
                                        Click="PreviousLessonPage" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Background="#00A6D6"
                                        Content="Следующая страница"
                                        IsEnabled="{Binding CanGoNextLessonPage}"
                                        Click="NextLessonPage" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
