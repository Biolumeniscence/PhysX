<Window x:Class="PhysX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="560"
        Height="420"
        MinWidth="460"
        MinHeight="340"
        Background="#EEF2F5"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="RoundedSettingsButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#20252B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonShell"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#F7F9FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="22"
            CornerRadius="24"
            Background="#F8FAFC"
            BorderBrush="#E1E7EE"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Настройки"
                           FontSize="30"
                           FontWeight="Black"
                           Foreground="#20252B" />
                <TextBlock Text="Базовые настройки уже разложены по вкладкам. Часть переключателей пока работает как заготовка интерфейса."
                           Margin="0,6,0,0"
                           Foreground="#66717D"
                           FontSize="14" />
            </StackPanel>

            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="#D7DEE6">
                <TabItem Header="Общее">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <StackPanel>
                            <CheckBox Content="Открывать последний раздел при запуске"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                            <CheckBox Content="Показывать подтверждение перед выходом"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                            <TextBlock Text="Режим запуска"
                                       Margin="0,10,0,6"
                                       Foreground="#66717D"
                                       FontWeight="Bold" />
                            <ComboBox SelectedIndex="0" Height="36">
                                <ComboBoxItem Content="Обычный режим" />
                                <ComboBoxItem Content="Учебный режим без таймеров" />
                                <ComboBoxItem Content="Подготовка к проверочной" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Интерфейс">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Размер текста в уроках"
                                       Foreground="#66717D"
                                       FontWeight="Bold" />
                            <Slider Minimum="14"
                                    Maximum="22"
                                    Value="17"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,8,0,16" />
                            <CheckBox Content="Открывать учебные изображения в большом окне"
                                      IsChecked="True"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                            <CheckBox Content="Показывать прогресс страницы в уроке"
                                      IsChecked="True"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                        </StackPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Обучение">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <StackPanel>
                            <CheckBox Content="Перемешивать карточки в заданиях"
                                      IsChecked="True"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                            <CheckBox Content="Показывать подсказки после ошибки"
                                      IsChecked="True"
                                      Margin="0,0,0,12"
                                      FontWeight="SemiBold"
                                      Foreground="#20252B" />
                            <TextBlock Text="Время практического экзамена"
                                       Margin="0,10,0,6"
                                       Foreground="#66717D"
                                       FontWeight="Bold" />
                            <ComboBox SelectedIndex="1" Height="36">
                                <ComboBoxItem Content="3 минуты" />
                                <ComboBoxItem Content="5 минут" />
                                <ComboBoxItem Content="10 минут" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2"
                    Width="120"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource RoundedSettingsButtonStyle}"
                    Content="Закрыть"
                    Click="CloseSettings" />
        </Grid>
    </Border>
</Window>
