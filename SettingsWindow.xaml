<Window x:Class="PhysX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="560"
        Height="420"
        MinWidth="460"
        MinHeight="340"
        Background="#EEF2F5"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="RoundedSettingsButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#20252B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonShell"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShell" Property="Background" Value="#F7F9FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="22"
            CornerRadius="24"
            Background="#F8FAFC"
            BorderBrush="#E1E7EE"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Настройки"
                           FontSize="30"
                           FontWeight="Black"
                           Foreground="#20252B" />
                <TextBlock Text="Окно уже заведено, содержимое оставлено как каркас."
                           Margin="0,6,0,0"
                           Foreground="#66717D"
                           FontSize="14" />
            </StackPanel>

            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="#D7DEE6">
                <TabItem Header="Общее">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <TextBlock Text="Здесь позже будут общие настройки приложения."
                                   Foreground="#66717D"
                                   TextWrapping="Wrap" />
                    </Border>
                </TabItem>
                <TabItem Header="Интерфейс">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <TextBlock Text="Здесь позже будут параметры внешнего вида."
                                   Foreground="#66717D"
                                   TextWrapping="Wrap" />
                    </Border>
                </TabItem>
                <TabItem Header="Обучение">
                    <Border Padding="18"
                            CornerRadius="16"
                            Background="White"
                            BorderBrush="#D7DEE6"
                            BorderThickness="1">
                        <TextBlock Text="Здесь позже будут настройки уроков, заданий и таймеров."
                                   Foreground="#66717D"
                                   TextWrapping="Wrap" />
                    </Border>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2"
                    Width="120"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource RoundedSettingsButtonStyle}"
                    Content="Закрыть"
                    Click="CloseSettings" />
        </Grid>
    </Border>
</Window>
